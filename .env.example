# このファイルをコピーして「.env」という名前にし、自分の値を入れてください。
#   コピー方法:  cp .env.example .env
# 「.env」は .gitignore で除外されており、GitHub には上がりません。
# このファイル(.env.example)には、本物のIDやキーを絶対に書かないでください。

# --- 楽天ウェブサービス(https://webservice.rakuten.co.jp/) ---
# アプリケーションID(アプリ登録後に表示されます)
RAKUTEN_APPLICATION_ID=ここにアプリケーションID
# アクセスキー(2026年2月以降の新APIで必要。「pk_」で始まる文字列)
RAKUTEN_ACCESS_KEY=ここにアクセスキー
# 楽天アフィリエイトID(楽天アフィリエイト管理画面で確認できます)
RAKUTEN_AFFILIATE_ID=ここにアフィリエイトID

# --- 任意の設定 ---
# APIのURL。通常は変更不要です。楽天側の仕様変更があったときだけ書き換えます。
# RAKUTEN_API_ENDPOINT=https://openapi.rakuten.co.jp/ichibams/api/IchibaItem/Search/20220601
# 楽天ウェブサービスのアプリ登録時に「許可されたWebサイト」として入れたURL
# (403エラーが出るときに設定します)
# RAKUTEN_REFERER=https://example.com/
